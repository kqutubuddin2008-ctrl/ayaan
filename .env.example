# Use MySQL 8 in deployment; SQLite is only a local/test fallback.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://attendance_user:change-me@localhost:3306/smart_attendance
BIOMETRIC_ENCRYPTION_KEY=
FLASK_ENV=development
SESSION_COOKIE_SECURE=false
RECOGNITION_DISTANCE_THRESHOLD=0.42
LIVENESS_MIN_MOVEMENT=8
LOW_ATTENDANCE_THRESHOLD=75
LATE_THRESHOLD_MINUTES=10
SESSION_TIMEOUT_MINUTES=45
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_CONTENT_LENGTH=5242880
